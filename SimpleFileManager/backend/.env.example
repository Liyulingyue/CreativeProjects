# LLM Configuration (for chat/completion)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.minimaxi.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Embedding Configuration (for vectorization)
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://api.minimaxi.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=AUTO  # AUTO, 1536, 3072, etc.

# Index Configuration
INDEX_INTERVAL=300
STORAGE_PATH=./data

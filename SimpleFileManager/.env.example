# SimpleFileManager Environment Configuration
# Copy to .env and edit. Works for both dev mode and Docker Compose.
# These are initial values — once saved via Settings UI, settings.json takes priority.

# Auth — initial password set on first startup (changeable via UI later)
INIT_PASSWORD=

# LLM Configuration (chat / agent / digest)
# Local LLMServices: http://127.0.0.1:9010/v1/chat/completions (dev)
# Docker:           http://host.docker.internal:9010/v1/chat/completions
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:9010/v1/chat/completions
LLM_MODEL=LFM2.5-8B-A1B-Q8_0

# Embedding Configuration (vector search)
# Local LLMServices: http://127.0.0.1:9011/v1/embeddings (dev)
# Docker:           http://host.docker.internal:9011/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://127.0.0.1:9011/v1/embeddings
EMBEDDING_MODEL=Qwen3-Embedding-0.6B-Q8_0
EMBEDDING_DIM=1024

# Index Configuration
INDEX_INTERVAL=300
AUTO_INDEX_ENABLED=true
INDEX_DEBOUNCE_SECONDS=10

# Agent Configuration
MAX_AGENT_STEPS=8

# Model context window size (tokens) — set to your model's limit
# 32768 (32K), 131072 (128K), 1048576 (1M), etc.
MAX_CONTEXT_TOKENS=32768

# Auto Digest — daily summary auto-generation
# Mode: scheduled (daily at fixed hour) | interval (every N hours)
AUTO_DIGEST_ENABLED=false
AUTO_DIGEST_MODE=scheduled
AUTO_DIGEST_HOUR=23
AUTO_DIGEST_INTERVAL_HOURS=6

# Dev mode: STORAGE_PATH is relative to backend/ dir
# Docker: STORAGE_PATH is set to /data in docker-compose.yml
# STORAGE_PATH=../data

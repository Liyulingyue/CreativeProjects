# SimpleFileManager Environment Configuration
# Copy to .env and edit. Works for both dev mode and Docker Compose.
# These are initial values — once saved via Settings UI, settings.json takes priority.

# Auth — initial password set on first startup (changeable via UI later)
INIT_PASSWORD=

# LLM Configuration (chat / agent / digest)
# Local LLMServices: http://127.0.0.1:9010/v1/chat/completions (dev)
# Docker:           http://host.docker.internal:9010/v1/chat/completions
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:9010/v1/chat/completions
LLM_MODEL=LFM2.5-24B-A2B-Q4_K_M

# Embedding Configuration (vector search)
# Local LLMServices: http://127.0.0.1:9011/v1/embeddings (dev)
# Docker:           http://host.docker.internal:9011/v1/embeddings
#
# bge-base-zh-v1.5 (105 MB Q8_0, 768-dim) is the default: Chinese-specific,
# cheap to host, and consistent with what LLMServices/serve.sh ships with.
# Override INDEX_CHUNK_SIZE / INDEX_CHUNK_OVERLAP to retune the indexer for
# models with larger context windows (e.g. Qwen3-Embedding-0.6B at 32K).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://127.0.0.1:9011/v1/embeddings
EMBEDDING_MODEL=bge-base-zh-v1.5
EMBEDDING_DIM=768
INDEX_CHUNK_SIZE=400
INDEX_CHUNK_OVERLAP=60

# Dedicated embedding endpoint for the user-facing search/chat path. By
# default this is the same endpoint as EMBEDDING_BASE_URL; on this box we
# override it to point at a GPU-backed llama-server (port 9012) so user
# queries have a low-latency path that does not queue behind the indexer's
# batched work on the A520 LITTLE cores. Leave unset for cloud-only setups.
# EMBEDDING_SEARCH_URL=http://127.0.0.1:9012/v1/embeddings
# EMBEDDING_SEARCH_MODEL=bge-base-zh-v1.5

# Index Configuration
INDEX_INTERVAL=300
AUTO_INDEX_ENABLED=true
INDEX_DEBOUNCE_SECONDS=10

# Agent Configuration
MAX_AGENT_STEPS=8

# Model context window size (tokens) — set to your model's limit
# 32768 (32K), 131072 (128K), 1048576 (1M), etc.
MAX_CONTEXT_TOKENS=32768

# Auto Digest — daily summary auto-generation
# Mode: scheduled (daily at fixed hour) | interval (every N hours)
AUTO_DIGEST_ENABLED=false
AUTO_DIGEST_MODE=scheduled
AUTO_DIGEST_HOUR=23
AUTO_DIGEST_INTERVAL_HOURS=6

# Dev mode: STORAGE_PATH is relative to backend/ dir
# Docker: STORAGE_PATH is set to /data in docker-compose.yml
# STORAGE_PATH=../data

# ---- LLM serving knobs (LLMServices/serve.sh reads these) ----

# THINKING_ENABLED — LFM2.5-A2B thinking/scratchpad. true = full thinking
# (default), false = llama-server launched with --reasoning-budget 0 so
# the model skips the scratchpad. Changing requires `serve.sh restart`.
# THINKING_ENABLED=true

# LLM_FAST_ENABLED — bring up the small (350M) model on port 9013 for
# per-turn `use_fast` chat requests. Requires the gguf at
# models/lfm25-350m-q4_0/LFM2.5-350M-Q4_0.gguf; otherwise the start is
# silently skipped so a fresh checkout still works with just the 24B.
# LLM_FAST_ENABLED=true

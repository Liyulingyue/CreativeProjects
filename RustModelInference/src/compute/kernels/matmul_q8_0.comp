#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_8bit_storage: require

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) readonly buffer Weight {
    uint w_data[];
};

layout(set = 0, binding = 1) readonly buffer Input {
    uint i_data[];
};

layout(set = 0, binding = 2) readonly buffer InputScales {
    float s[];
};

layout(set = 0, binding = 3) writeonly buffer Output {
    float y[];
};

layout(push_constant) uniform Params {
    uint n_in;
    uint n_out;
    uint n_blocks;
} params;

void main() {
    uint tid = gl_LocalInvocationIndex;
    uint block_idx = gl_WorkGroupID.x;
    uint out_idx = block_idx * 32 + tid;

    if (out_idx >= params.n_out) return;

    float sum = 0.0f;

    for (uint blk = 0; blk < params.n_blocks; blk++) {
        uint weight_base = blk * 9;
        float weight_scale = uintBitsToFloat(w_data[weight_base + 8]);
        float input_scale = s[blk];

        for (uint j = 0; j < 8; j++) {
            uint w_packed = w_data[weight_base + j];
            uint i_packed = i_data[j];

            for (uint k = 0; k < 4; k++) {
                int w_val = int(int8_t((w_packed >> (k * 8)) & 0xFF));
                int i_val = int(int8_t((i_packed >> (k * 8)) & 0xFF));

                sum += float(w_val) * float(i_val) * weight_scale * input_scale;
            }
        }
    }

    y[out_idx] = sum;
}

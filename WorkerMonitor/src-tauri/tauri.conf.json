{
  "$schema": "./node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WorkerMonitor",
  "version": "0.1.0",
  "identifier": "com.workermonitor.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkerMonitor",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
